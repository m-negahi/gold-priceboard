# PriceBoard — .env e nemune.
# `cp .env.example .env` ba'd `APP_KEY` khodkar sakhte mishe (entrypoint).
# ⚠️ Taghir e in file ba `octane:reload` sovar NEMISHE → `up -d --force-recreate`.

# ── Docker / Compose ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=pb
USE_IRAN_MIRROR=false
PHP_VERSION=8.5
POSTGRES_VERSION=18
REDIS_VERSION=8
INFLUX_VERSION=2.7
USER_ID=1000
GROUP_ID=1000

# ── App ────────────────────────────────────────────────────────────
APP_NAME=PriceBoard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8300
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
SEO_INDEXABLE=false

# ── Octane ─────────────────────────────────────────────────────────
OCTANE_SERVER=swoole
OCTANE_PORT=8300
OCTANE_WORKERS=1
OCTANE_TASK_WORKERS=1
OCTANE_MAX_REQUESTS=500
OCTANE_WATCH=true

# ── Vite ───────────────────────────────────────────────────────────
# ⚠️ vite.config.js ham bayad `port: 5373, strictPort: true` bashe.
VITE_PORT=5373
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=500

# ── Database (Postgres) ────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgresql
DB_PORT=5432
DB_DATABASE=priceboard
DB_USERNAME=priceboard
DB_PASSWORD=secret
DB_EXTERNAL_PORT=55434

# ── Redis e omumi (cache / session / queue) ────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_EXTERNAL_PORT=56381

# ── Redis e gheymat (JODA — noeviction) ────────────────────────────
# Gheymat ha INJA mishinan, BEDUN e TTL. Ru `redis` e omumi nanevis:
# un `allkeys-lru` ast va tu feshar e memory kelid e gheymat ro evict mikone
# dar hali ke salem be nazar mirese → board bedun e error khali mishe.
REDIS_PRICES_HOST=redis-prices
REDIS_PRICES_PORT=6379
REDIS_PRICES_PASSWORD=secret
REDIS_PRICES_EXTERNAL_PORT=56382

CACHE_STORE=redis
CACHE_PREFIX=pb_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
HORIZON_PREFIX=pb_horizon_
BROADCAST_CONNECTION=null

# ── InfluxDB (time-series) ─────────────────────────────────────────
INFLUX_USERNAME=priceboard
INFLUX_PASSWORD=secret12345
INFLUX_ORG=priceboard
INFLUX_BUCKET=ticks
INFLUX_RETENTION=30d
INFLUX_EXTERNAL_PORT=8386
INFLUX_ADMIN_TOKEN=priceboard-local-admin-token

PRICING_INFLUX_URL=http://influxdb:8086
PRICING_INFLUX_ORG=priceboard
# Do token e joda: worker faghat mineviseh, web faghat mikhune.
# `pricing:influx:provision` misazatesh va inja chap mikone.
PRICING_INFLUX_WRITE_TOKEN=
PRICING_INFLUX_READ_TOKEN=
PRICING_INFLUX_QUERY_TIMEOUT=5
PRICING_INFLUX_WRITE_TIMEOUT=2

# ── Pricing ────────────────────────────────────────────────────────
PRICING_TICK_SECONDS=15
PRICING_TIMEOUT=10
# Offset e Tehran baraye window e candle (Iran az 2022 DST nadare).
# Bedun e in, candle e ruzane be 03:30 e Tehran align mishe na 00:00.
PRICING_TZ_OFFSET=3h30m
# Saghf e enheraf e tick-be-tick (darsad) — zed e parse e kharab.
PRICING_MAX_DEVIATION_IRR=10
PRICING_MAX_DEVIATION_USD=5
PRICING_LOG=true
PRICING_LOG_DAYS=14
PRICING_LOG_LEVEL=info

# ── OTP ────────────────────────────────────────────────────────────
OTP_LENGTH=5
OTP_EXPIRES_IN=120
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=3

# 🔴 FAGHAT dev/staging. HARGEZ tu production.
# `true` bashe:
#   1. code e tolid-shode zir e form e OTP neshun dade mishe
#   2. yek dokme ye «پر کردن خودکار» kenar e input miad ke code ro khodesh mizare tu input
# `false` bashe: na code neshun dade mishe، na dokme — eyn e production.
BYPASS_OTP=true

# ── SMS ────────────────────────────────────────────────────────────
# driver ha:
#   kavenegar → SMS e vaghei (fe'lan tanha driver e vaghei؛ fallback ba'dan)
#   log       → faghat tu storage/logs/laravel.log minevise (dev)
#   fake      → tu memory negah midare، hich IO. baraye test: `Sms::assertSentTo(...)`
SMS_DRIVER=fake
SMS_TIMEOUT=10
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE_OTP=verify

# ── Logging / Sentry ───────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# ── Dev tools ──────────────────────────────────────────────────────
TELESCOPE_ENABLED=true
PULSE_ENABLED=true
DB_SEED=false
FILESYSTEM_DISK=local
XDEBUG_MODE=off

# ── Mail ───────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@priceboard.local"
MAIL_FROM_NAME="${APP_NAME}"
